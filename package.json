{
  "name": "whitebrick",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:lan": "npm run build && tsx server/index.ts",
    "server": "node server/start.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-test.mjs",
    "test:skins": "node scripts/skins-browser-test.mjs",
    "test:survival": "node scripts/survival-browser-test.mjs",
    "test:settings": "node scripts/settings-browser-test.mjs",
    "test:expansion": "node scripts/expansion-browser-test.mjs",
    "test:commands": "node scripts/commands-browser-test.mjs",
    "test:lan": "tsx scripts/lan-browser-test.mjs",
    "test:inventory": "tsx scripts/inventory-browser-test.mjs",
    "format": "prettier --write src tests scripts server vite.config.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "three": "^0.180.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.12"
  }
}
